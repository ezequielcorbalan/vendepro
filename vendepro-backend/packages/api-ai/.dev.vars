# VendéPro — api-ai — Variables de desarrollo local
# ⚠️  SOLO PARA LOCAL. Producción usa Cloudflare Worker secrets.

# Mismo JWT_SECRET que api-auth (los demás workers verifican tokens emitidos
# por api-auth, así que el secret debe coincidir).
JWT_SECRET=dev-local-jwt-secret-do-not-use-in-production-0123456789abcdef

# Claves de proveedores IA. Dummy: cualquier endpoint que las use va a fallar
# con 401/403. Si necesitás probar extracción/IA real, ponelas en .dev.vars.local.
ANTHROPIC_API_KEY=dev-placeholder-anthropic-key
GROQ_API_KEY=dev-placeholder-groq-key
