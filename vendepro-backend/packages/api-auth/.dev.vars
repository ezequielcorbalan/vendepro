# VendéPro — api-auth — Variables de desarrollo local
# ⚠️  SOLO PARA LOCAL. Producción usa Cloudflare Worker secrets.
# Cambiar a valores reales en .dev.vars.local (no commiteado) si hace falta.

# JWT secret compartido por TODOS los workers (firma en api-auth, verificación
# en los demás). Debe ser idéntico en todos los .dev.vars.
JWT_SECRET=dev-local-jwt-secret-do-not-use-in-production-0123456789abcdef

# Servicio de emails (forgot-password), vía Resend. Dummy en dev — el envío real
# falla, pero la generación del token y el flow básico funcionan.
# Para probar envíos de verdad en local, poner una API key real en
# .dev.vars.local (no commiteado).
RESEND_API_KEY=dev-placeholder-resend-key

# Base del frontend usada para armar el link del email de recuperación.
APP_BASE_URL=http://localhost:3000
