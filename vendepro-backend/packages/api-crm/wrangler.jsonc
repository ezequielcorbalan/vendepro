{
  "name": "vendepro-api-crm",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "crm.api.vendepro.com.ar", "custom_domain": true }
  ],
  "triggers": {
    // */15: sync KiteProp · */5: campañas de email + cola de automatizaciones
    "crons": ["*/15 * * * *", "*/5 * * * *"]
  },
  "vars": {
    // Base pública para los links que van dentro de los emails
    // (reportes de propiedad, tasaciones, baja de suscripción).
    "PUBLIC_BASE_URL": "https://www.marcelagenta.com",
    // URL pública de este worker — el cron la usa para el webhook de Google.
    "PUBLIC_API_URL": "https://crm.api.vendepro.com.ar"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vendepro-db",
      "database_id": "45d18f94-807b-466f-8742-32bbc61fc7fb"
    }
  ]
}
