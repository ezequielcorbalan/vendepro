# VendéPro — api-properties — Variables de desarrollo local
# ⚠️  SOLO PARA LOCAL. Producción usa Cloudflare Worker secrets.

JWT_SECRET=dev-local-jwt-secret-do-not-use-in-production-0123456789abcdef

# URL pública del bucket R2 (para servir fotos/PDFs). En local los uploads
# van al R2 simulado de wrangler — esta URL no resuelve realmente, pero el
# binding sigue funcionando para mutaciones.
R2_PUBLIC_URL=http://localhost:8703/r2-local
