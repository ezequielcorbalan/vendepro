{
  "name": "vendepro-api-properties",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "properties.api.vendepro.com.ar", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vendepro-db",
      "database_id": "45d18f94-807b-466f-8742-32bbc61fc7fb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "vendepro-assets"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "API_PUBLIC_URL": "https://public.api.vendepro.com.ar",
    // URL pública desde donde el navegador va a levantar los assets de R2.
    // Debe apuntar a un endpoint que sirva el contenido (`/<key>`). En prod
    // se usa el proxy `/photo/*` del propio worker (público, sin auth).
    // En dev local `start-local.sh` la sobreescribe con `http://localhost:8789/photo`.
    "R2_PUBLIC_URL": "https://properties.api.vendepro.com.ar/photo"
  }
}
