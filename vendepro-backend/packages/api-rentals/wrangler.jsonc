{
  "name": "vendepro-api-rentals",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "rentals.api.vendepro.com.ar", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vendepro-rentals-db",
      // BLOQUEA EL DEPLOY: crear la DB "vendepro-rentals-db" en el dashboard de
      // Cloudflare (D1), aplicar migrations/0001_initial.sql y pegar el UUID real aca.
      "database_id": "REPLACE_WITH_ACTUAL_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "vendepro-rentals-docs"
    }
  ]
}
